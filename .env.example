# LLM Configuration
# Three-tier model selection: FAST (cheap operations), SMART (primary), STRATEGIC (complex planning)
HIVEFLOW_FAST_LLM=openai:gpt-4o-mini
HIVEFLOW_SMART_LLM=openai:gpt-4o
HIVEFLOW_STRATEGIC_LLM=openai:o3-mini

# LLM Provider API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Azure OpenAI
# Use the base resource URL (not the full deployment URL).
# The provider auto-strips /openai/deployments/... if you paste the full URL.
AZURE_OPENAI_ENDPOINT=https://my-resource.openai.azure.com
# API key auth (optional — omit to use RBAC via DefaultAzureCredential):
# AZURE_OPENAI_API_KEY=your_azure_key_here
# API version (optional, defaults to 2024-10-21):
# OPENAI_API_VERSION=2024-10-21

# Ollama (local LLM)
OLLAMA_BASE_URL=http://localhost:11434

# llama.cpp (local LLM)
LLAMACPP_MODEL_PATH=/path/to/model.gguf

# Embedding Configuration
HIVEFLOW_EMBEDDING_PROVIDER=huggingface  # huggingface (local transformer, core dep), local (numpy hashing), openai (API)
# HIVEFLOW_EMBEDDING_MODEL=  # Provider-specific; empty = provider default
# Fallback (zero extra deps): HIVEFLOW_EMBEDDING_PROVIDER=local
# OpenAI (API):               HIVEFLOW_EMBEDDING_PROVIDER=openai  (requires OPENAI_API_KEY)

# Search/Retrieval API Keys
TAVILY_API_KEY=your_tavily_api_key_here
GOOGLE_CUSTOM_SEARCH_API_KEY=your_google_search_key_here
GOOGLE_CUSTOM_SEARCH_CX=your_search_engine_id_here
BING_SEARCH_API_KEY=your_bing_key_here

# Scraping Configuration
HIVEFLOW_SCRAPER=beautifulsoup
HIVEFLOW_MAX_SCRAPER_WORKERS=15
HIVEFLOW_SCRAPER_RATE_LIMIT_DELAY=0.1

# Context and Compression
HIVEFLOW_SIMILARITY_THRESHOLD=0.35
HIVEFLOW_BROWSE_CHUNK_MAX_LENGTH=1000
HIVEFLOW_CHUNK_OVERLAP=200
HIVEFLOW_TOTAL_WORDS=8000

# Output Configuration
HIVEFLOW_REPORT_FORMAT=apa
HIVEFLOW_LANGUAGE=english
HIVEFLOW_TONE=objective
HIVEFLOW_PUBLISH_FORMATS=  # Empty = all discovered publishers; or comma-separated: pdf,markdown,docx,html,json
HIVEFLOW_OUTPUT_DIR=./output

# Deep Research
HIVEFLOW_DEEP_RESEARCH_BREADTH=3
HIVEFLOW_DEEP_RESEARCH_DEPTH=2
HIVEFLOW_DEEP_RESEARCH_CONCURRENCY=4

# Logging & Observability
HIVEFLOW_ENV=development          # "development" = pretty console, "production" = JSON lines
HIVEFLOW_LOG_LEVEL=INFO
# HIVEFLOW_OTEL_ENABLED=true     # Enable OpenTelemetry spans and metrics (default: false)

# Cost Tracking
HIVEFLOW_ENABLE_COST_TRACKING=true
